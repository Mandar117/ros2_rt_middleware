<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_rt_middleware</name>
  <version>0.2.0</version>
  <description>
    Custom real-time executor and latency benchmarking suite for ROS2.
    Lock-free callback queuing, absolute-deadline periodic release, thread
    pinning, SCHED_FIFO scheduling, loaned-message and POSIX shared-memory
    transports, and a stock-vs-RT executor benchmark.
  </description>
  <maintainer email="sagar.gokhale02@gmail.com">Sagar Gokhale</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rmw</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
