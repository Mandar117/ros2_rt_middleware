<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_rt_middleware</name>
  <version>0.1.0</version>
  <description>
    Custom real-time executor and latency benchmarking suite for ROS2.
    Demonstrates lock-free callback queuing, thread pinning, SCHED_FIFO
    scheduling, and zero-copy shared-memory transport.
  </description>
  <maintainer email="sagar.gokhale02@gmail.com">Sagar Gokhale</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_gtest</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rmw</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
